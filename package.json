{
  "name": "snaplingo",
  "private": true,
  "version": "0.1.23",
  "type": "module",
  "scripts": {
    "ocr:prepare": "node script/prepare-ocr.mjs",
    "dev": "npm run native:dev",
    "build": "npm run native:build",
    "native:dev": "node script/native-run.mjs --build",
    "native:run": "node script/native-run.mjs",
    "native:build": "node script/native-build.mjs build",
    "native:bundle": "node script/native-build.mjs bundle",
    "reference:dev": "vite --config reference/web/vite.config.ts",
    "reference:build": "node script/third-party-notices.mjs --check && tsc --project reference/web/tsconfig.json && vite build --config reference/web/vite.config.ts",
    "reference:preview": "vite preview --config reference/web/vite.config.ts",
    "licenses:generate": "node script/third-party-notices.mjs",
    "test": "vitest run",
    "release:build": "node script/release-verification.mjs build",
    "release:verify": "node script/release-verification.mjs verify",
    "release:collect": "node script/release-verification.mjs collect"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.8",
    "linkify-it": "^5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/linkify-it": "^5.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "happy-dom": "^20.10.6",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.1",
    "vitest": "^4.1.9"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gamilian/snaplingo.git"
  }
}
